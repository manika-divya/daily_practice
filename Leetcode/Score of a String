class Solution 
{
    public int scoreOfString(String s) 
    {
        int count = 0;
        for(int i =0;i<s.length()-1;i++)
        {
            char a = s.charAt(i);
            char b = s.charAt(i+1);
            int m = a ;
            int n = b;
            count = count + Math.abs(m-n);
        }        
        return count;
    }
}